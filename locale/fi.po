msgstr "Sammutettu"

#: usr/share/big-screen-monitor-display/screentray/states.py:47
msgid "Unavailable"
msgstr "Ei käytettävissä"

#: usr/share/big-screen-monitor-display/screentray/states.py:56
msgid "The display is connected but does not answer."
msgstr "Näyttö on yhdistetty, mutta se ei vastaa."

#: usr/share/big-screen-monitor-display/screentray/states.py:57
msgid "Unplug the display's cable and plug it in again."
msgstr "Irrota näytön kaapeli ja kytke se uudelleen."

#: usr/share/big-screen-monitor-display/screentray/states.py:58
msgid "The display is not connected."
msgstr "Näyttöä ei ole yhdistetty."

#: usr/share/big-screen-monitor-display/screentray/states.py:59
msgid "This display is not connected now. Choose another one or plug it in."
msgstr "Tätä näyttöä ei ole nyt yhdistetty. Valitse toinen tai kytke se."

#: usr/share/big-screen-monitor-display/screentray/states.py:60
msgid "The backlight is off; the theme keeps running."
msgstr "Taustavalo on sammutettu; teema jatkaa toimintaansa."

#: usr/share/big-screen-monitor-display/screentray/states.py:61
msgid "Turned off in the configuration window."
msgstr "Sammutettu asetusikkunassa."

#: usr/share/big-screen-monitor-display/screentray/states.py:62
msgid "Transfers are failing now and then; the service keeps retrying."
msgstr "Siirrot epäonnistuvat silloin tällöin; palvelu yrittää jatkuvasti uudelleen."

#: usr/share/big-screen-monitor-display/screentray/states.py:63
msgid "The service is reconnecting to the display."
msgstr "Palvelu yhdistää näyttöön uudelleen."

#: usr/share/big-screen-monitor-display/screentray/states.py:64
msgid "The monitor service is not running."
msgstr "Valvontapalvelu ei ole käynnissä."

#: usr/share/big-screen-monitor-display/screentray/states.py:133
msgid "All displays working"
msgstr "Kaikki näytöt toimivat"

#: usr/share/big-screen-monitor-display/screentray/states.py:134
msgid "Attention needed on a display"
msgstr "Jokin näyttö vaatii huomiota"


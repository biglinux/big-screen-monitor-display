msgstr "Näytöt yhdistyvät uudelleen muutamassa sekunnissa."

#: usr/share/big-screen-monitor-display/traykit/base.py:266
msgid "Could not restart the service"
msgstr "Palvelua ei voitu käynnistää uudelleen"

#: usr/share/big-screen-monitor-display/traykit/base.py:275
msgid "Could not reconnect"
msgstr "Uudelleenyhdistäminen epäonnistui"

#: usr/share/big-screen-monitor-display/traykit/base.py:286

#: usr/share/big-screen-monitor-display/media_player_page.py:287
msgid "GPU temperature"
msgstr "Temperatura GPU-a"

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:45
msgid "One three-digit field (temperature or usage), a 10-step usage bar and an alarm lamp."
msgstr "Jedno troznamenkasto polje (temperatura ili iskorištenost), traka iskorištenosti s 10 koraka i lampica alarma."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:46
msgid "SE variants send the same data without the HID report id; detected from the product name."
msgstr "SE inačice šalju iste podatke bez HID report ID-a; prepoznaje se po nazivu proizvoda."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:49
msgid "Two digits only (99 is the highest value shown); Celsius only; no usage bar."
msgstr "Samo dvije znamenke (99 je najveća prikazana vrijednost); samo Celzijevi stupnjevi; bez trake iskorištenosti."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:52
msgid "One field that shows temperature or power, plus a 10-step usage bar."
msgstr "Jedno polje koje prikazuje temperaturu ili snagu, uz traku iskorištenosti s 10 koraka."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:55
#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:60
msgid "warning at 80 °C, limit at 90 °C (fixed by the firmware)"
msgstr "upozorenje na 80 °C, ograničenje na 90 °C (određuje firmver)"

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:56
msgid "The firmware shows power, temperature, usage and frequency; their layout cannot be changed."
msgstr "Firmver prikazuje snagu, temperaturu, iskorištenost i frekvenciju; njihov se raspored ne može promijeniti."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:61
msgid "The firmware shows power, temperature and usage; no frequency field."
msgstr "Firmver prikazuje snagu, temperaturu i iskorištenost; bez polja frekvencije."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:63
msgid "limit at 85 °C (fixed by the firmware)"
msgstr "ograničenje na 85 °C (određuje firmver)"

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:64
msgid "The firmware shows power, temperature and usage; leading zeros can be shown or hidden."
msgstr "Firmver prikazuje snagu, temperaturu i iskorištenost; vodeće nule mogu se prikazati ili sakriti."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:67
msgid "ring colour follows the CPU temperature (thresholds in the firmware)"
msgstr "boja prstena prati temperaturu procesora (pragovi su u firmveru)"

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:69
msgid "2.8\" LCD (480×640) in its native information mode: CPU temperature, usage and clock, memory usage and GPU temperature; rotation in 90° steps."
msgstr "2,8\" LCD (480×640) u izvornom informacijskom načinu: temperatura, iskorištenost i takt procesora, iskorištenost memorije i temperatura GPU-a; zakretanje u koracima od 90°."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:71
msgid "Custom images and GIFs are not sent: the transfer writes to the cooler's permanent memory and is known to leave it unable to return to the information mode."
msgstr "Prilagođene slike i GIF-ovi ne šalju se: prijenos piše u trajnu memoriju hladnjaka, a poznato je da se hladnjak nakon toga ne može vratiti u informacijski način."

#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:93
#: usr/share/big-screen-monitor-display/bsmd/displays/deepcool/models.py:95

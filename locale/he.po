#: usr/share/big-screen-monitor-display/traykit/session.py:23
msgid "USB displays"
msgstr "תצוגות USB"

#: usr/share/big-screen-monitor-display/traykit/session.py:23
msgid "Theme gallery, brightness and orientation from an icon in the panel."
msgstr "גלריית ערכות עיצוב, בהירות וכיוון מסמל בלוח."

#: usr/share/big-screen-monitor-display/traykit/session.py:25
msgid "DeepCool coolers"
msgstr "מצנני DeepCool"

#: usr/share/big-screen-monitor-display/traykit/session.py:25
msgid "CPU temperature in the panel and the cooler's display options."
msgstr "טמפרטורת ה־CPU בלוח ואפשרויות התצוגה של המצנן."

#: usr/share/big-screen-monitor-display/traykit/session.py:111
msgid "GNOME shows tray icons only with the “AppIndicator and KStatusNotifierItem Support” extension. Install it from your distribution (gnome-shell-extension-appindicator) or from extensions.gnome.org and enable it in Extensions; the icon then appears the next time you open this app."
msgstr "GNOME מציג סמלים במגש רק עם ההרחבה „AppIndicator and KStatusNotifierItem Support”. יש להתקין אותה מההפצה (gnome-shell-extension-appindicator) או מ־extensions.gnome.org ולהפעיל אותה ב„הרחבות”; הסמל יופיע בפעם הבאה שיישום זה ייפתח."

#: usr/share/big-screen-monitor-display/traykit/session.py:116
msgid "Window Maker has no notification area: open the controls from the applications menu or a Dock icon whenever you need them; the display keeps working without it."
msgstr "ל־Window Maker אין אזור הודעות: יש לפתוח את הפקדים מתפריט היישומים או מסמל ב־Dock בכל פעם שיש בהם צורך; התצוגה ממשיכה לפעול גם בלעדיו."

#: usr/share/big-screen-monitor-display/traykit/session.py:119
msgid "This desktop has no notification area (system tray) running, so the controls are shown in this window. Add a system tray to your panel to get the icon."
msgstr "בשולחן עבודה זה לא פועל אזור הודעות (מגש המערכת), ולכן הפקדים מוצגים בחלון זה. יש להוסיף מגש מערכת ללוח כדי לקבל את הסמל."

#: usr/share/big-screen-monitor-display/traykit/session.py:121
msgid "This desktop has no notification area (system tray) running. Add a system tray to your panel to get the icon; meanwhile the controls open in a window from the applications menu."
msgstr "בשולחן עבודה זה לא פועל אזור הודעות (מגש המערכת). יש להוסיף מגש מערכת ללוח כדי לקבל את הסמל; בינתיים הפקדים נפתחים בחלון מתפריט היישומים."

#: usr/share/big-screen-monitor-display/traykit/session.py:179
msgid "Tray icon turned on. You can switch it off in Preferences."
msgstr "הסמל במגש הופעל. אפשר לכבות אותו בהעדפות."

#: usr/share/big-screen-monitor-display/traykit/window.py:94
msgid "Connection state"
msgstr "מצב החיבור"

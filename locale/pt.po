msgid "udev rule installed"
msgstr "Regra udev instalada"

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:101
msgid "Administrative helper installed"
msgstr "Assistente administrativo instalado"

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:109
#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:113
msgid "Settings file"
msgstr "Arquivo de configurações"

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:110
#, python-brace-format
msgid "Old per-user settings found in {path}; they can be imported."
msgstr ""
"Configurações antigas encontradas em {path}; elas podem ser importadas."

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:114
msgid "Using defaults (no file yet)"
msgstr "Usando os padrões (ainda sem arquivo)"

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:119
#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:124
msgid "Service health report"
msgstr "Relatório de saúde do serviço"

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:120
msgid "The service has not published a health report."
msgstr "O serviço não publicou um relatório de saúde."

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:125
#, python-brace-format
msgid "Updated {age:.0f}s ago, state: {state}"
msgstr "Atualizado há {age:.0f}s, estado: {state}"

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:128
msgid "Communication with the display"
msgstr "Comunicação com o display"

#: usr/share/big-screen-monitor-display/bsmd/diagnostics.py:131
msgid "Rendering and transfer pipeline"
msgstr "Pipeline de renderização e transferência"


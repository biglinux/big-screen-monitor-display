msgstr "Услугата е рестартирана"

#: usr/share/big-screen-monitor-display/traykit/base.py:264
msgid "The displays reconnect in a few seconds."
msgstr "Дисплеите ще се свържат отново след няколко секунди."

#: usr/share/big-screen-monitor-display/traykit/base.py:266
msgid "Could not restart the service"
msgstr "Услугата не може да бъде рестартирана"

#: usr/share/big-screen-monitor-display/traykit/base.py:275
msgid "Could not reconnect"
msgstr "Повторното свързване е неуспешно"

#: usr/share/big-screen-monitor-display/traykit/base.py:286

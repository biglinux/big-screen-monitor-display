Icon=big-screen-monitor-deepcool
Terminal=false
StartupNotify=false
StartupWMClass=big-screen-monitor-deepcool
Categories=Settings;HardwareSettings;
Keywords=deepcool;cooler;ak400;ak500;ak620;ag400;temperature;cpu;tray;openrgb;

pkgname=big-screen-monitor-display
pkgdesc="Big Screen Monitor Display - hardware monitor and animated themes for USB LCD displays (AX206, Turing, XuanFang, Kipye, WeAct)"
depends=(
    # runtime
    'python'              # >= 3.10
    'python-pillow'       # rendering
    'python-numpy'        # RGB565 conversion and dirty rectangles
    'python-psutil'       # CPU, memory, disk, network, battery
    'python-pyusb'        # AX206 and Turing USB panels (libusb)
    'libusb'
    'python-pyserial'     # serial panels: Turing rev. A/C, XuanFang, Kipye, WeAct (CDC-ACM)
    'pciutils'            # lspci: GPU names
    'librsvg'             # rsvg-convert: icons, distro logo, splash, SVG wallpapers
    'fontconfig'          # fc-match: system fonts chosen for Kojiro widgets
    'systemd'             # service, watchdog, sysusers, udev
    'polkit'              # pkexec + bsm-helper authorization
    # configuration window
    'python-gobject'
    'python-cairo'        # Kojiro Design Studio canvas
    'glib2'
    'gtk4'
    'libadwaita'          # >= 1.6
    'hicolor-icon-theme'
)
optdepends=(
    'lm_sensors: detect and configure extra hardware sensors'
    'python-pystray: tray icon when running the monitor manually'
    'libcanberra: sound after applying settings'
    'pipewire-audio: Brother Away sound effects (pw-play)'
    'libpulse: Brother Away sound effects (paplay)'
    'alsa-utils: sound effects (aplay) and GKrellM volume module'
    'adwaita-fonts: font used by the GKrellM theme'
    'playerctl: media module of the GKrellM theme'
    'docker: container count in the GKrellM theme'
    'python-cryptography: faster header encryption for Turing USB panels (a built-in fallback exists)'
)
makedepends=('gettext' 'git')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL-3.0-or-later')
url="https://github.com/biglinux/$pkgname"
provides=("$pkgname")
source=("git+https://github.com/biglinux/$pkgname.git")
md5sums=(SKIP)

if [ -e "pkgbuild.install" ];then
    install=pkgbuild.install
fi

package() {
    # Detect project root
    if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}/${pkgname}"
    elif [ -d "${srcdir}/${pkgname}" ]; then
        InternalDir="${srcdir}/${pkgname}"
    else
        # Fallback for local builds outside of CI
        if [ -d "${startdir}/../usr/share/${pkgname}" ]; then
            InternalDir="${startdir}/.."
        else
            InternalDir="${startdir}"
        fi
    fi

    # Application, service, udev, sysusers, polkit and desktop files
    cp -r "${InternalDir}/usr" "${pkgdir}/"
    # Never ship development caches
    find "${pkgdir}" \( -name "__pycache__" -o -name ".ruff_cache" -o -name ".pytest_cache" \) \
        -type d -prune -exec rm -rf {} +

    # Compiled translations (empty catalogs are skipped)
    for po in "${InternalDir}/locale/"*.po; do
        [ -s "$po" ] || continue
        lang=$(basename "$po" .po)
        install -d "${pkgdir}/usr/share/locale/${lang}/LC_MESSAGES"
        msgfmt -o "${pkgdir}/usr/share/locale/${lang}/LC_MESSAGES/${pkgname}.mo" "$po"
    done

    # Permissions
    chmod 755 "${pkgdir}/usr/bin/"*
    chmod 755 "${pkgdir}/usr/share/${pkgname}/main.py" "${pkgdir}/usr/share/${pkgname}/config_gui.py"
    chmod 755 "${pkgdir}/usr/lib/${pkgname}/bsm-helper"
    chmod 644 "${pkgdir}/usr/lib/systemd/system/"*.service
    chmod 644 "${pkgdir}/usr/lib/udev/rules.d/"*.rules
    chmod 644 "${pkgdir}/usr/lib/sysusers.d/"*.conf
    chmod 644 "${pkgdir}/usr/share/polkit-1/actions/"*.policy
    chmod 644 "${pkgdir}/usr/share/polkit-1/rules.d/"*.rules
    # Settings live in /etc/big-screen-monitor-display/settings.json, created by
    # bsm-helper and never shipped, so upgrades always keep them.
}
